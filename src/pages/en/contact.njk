---
pageTitle: "Contact"
pageDescription: "FAS Expedition – Get in touch with us. We're happy to advise you on your expedition vehicle project."
altSlug:
  de: "kontakt"
  en: "contact"
---

{% from "macros/buttons.njk" import primaryBtn %}

{# Hero #}
<section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-zinc-950"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black"></div>
  <div class="relative z-10 text-center px-6">
    <h1 class="text-3xl md:text-5xl lg:text-7xl font-bold tracking-wider uppercase mb-6">Contact</h1>
    <p class="text-xl lg:text-2xl text-zinc-300">We look forward to your inquiry</p>
  </div>
</section>

{# Contact Form #}
<section class="bg-zinc-950 py-24 lg:py-32">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      {# Left: Form #}
      <div>
        <h2 class="text-3xl font-bold tracking-wider uppercase mb-4">Your Message</h2>
        <p class="text-zinc-400 text-sm mb-8">Have questions about our products or services? Fill out the contact form and we'll get back to you promptly.</p>

        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" class="space-y-6">
          {# Honeypot #}
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field"></label>
          </p>

          <div>
            <label for="name" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">Name *</label>
            <input type="text" id="name" name="name" required class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600" placeholder="Your full name">
          </div>

          <div>
            <label for="email" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">Email Address *</label>
            <input type="email" id="email" name="email" required class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600" placeholder="your@email.com">
          </div>

          <div>
            <label for="phone" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">Phone Number</label>
            <input type="tel" id="phone" name="phone" class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600" placeholder="+49 ...">
          </div>

          <div>
            <label for="file" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">Upload Files</label>
            <input type="file" id="file" name="file" multiple accept=".pdf,.doc,.docx,.jpg,.png" class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm file:mr-4 file:py-1 file:px-3 file:border file:border-zinc-700 file:text-xs file:uppercase file:tracking-widest file:font-bold file:bg-transparent file:text-zinc-400 file:hover:text-white file:transition-colors file:cursor-pointer">
          </div>

          <div>
            <label for="message" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">Your Message *</label>
            <textarea id="message" name="message" rows="6" required class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600 resize-y" placeholder="Describe your inquiry..."></textarea>
          </div>

          <button type="submit" class="inline-flex items-center space-x-3 bg-white text-black px-10 py-4 text-sm tracking-widest uppercase font-bold hover:bg-zinc-200 transition-colors">
            <span>Send Message</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </button>
        </form>
      </div>

      {# Right: Contact info #}
      <div>
        <h2 class="text-3xl font-bold tracking-wider uppercase mb-8">Contact Details</h2>

        <div class="space-y-6 mb-12">
          <div class="border border-zinc-800 p-6">
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Phone</p>
            <a href="tel:+4924739293422" class="text-white font-bold hover:text-zinc-300 transition-colors">+49 (0) 2473 929 3422</a>
          </div>
          <div class="border border-zinc-800 p-6">
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Email</p>
            <a href="mailto:info@fas-expedition.de" class="text-white font-bold hover:text-zinc-300 transition-colors">info@fas-expedition.de</a>
          </div>
          <div class="border border-zinc-800 p-6">
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Address</p>
            <p class="text-white font-bold">FAS Expedition GmbH</p>
            <p class="text-zinc-400 mt-1">Trafoweg 2-4<br>52152 Lammersdorf<br>Germany</p>
          </div>
          <div class="border border-zinc-800 p-6">
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Visit Us</p>
            <p class="text-zinc-300 text-sm">Would you like to visit us? No problem! Schedule an appointment today.</p>
          </div>
        </div>
      </div>

      {# Right: Legal notice #}
      <div id="impressum">
        <h2 class="text-3xl font-bold tracking-wider uppercase mb-8">Legal Notice</h2>
        <div class="space-y-6 text-zinc-300 text-sm leading-relaxed">
          <div>
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Responsible for content</p>
            <p class="text-white">FAS Expedition GmbH</p>
            <p>Trafoweg 2-4<br>52152 Lammersdorf / Germany</p>
            <p class="mt-2">Represented by managing director:<br>Diploma Engineer Andreas Böttcher</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Contact</p>
            <p>info@fas-expedition.de<br>+49 (0) 2473 929 3422</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Commercial Register</p>
            <p>HRB Aachen 24436</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">VAT ID</p>
            <p>DE340249521</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

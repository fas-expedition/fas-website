---
pageTitle: "Configurator"
pageDescription: "Configure your FAS expedition vehicle step by step"
altSlug:
  de: "konfigurator"
  en: "configurator"
---

{# Product data embedded as JSON for client-side access #}
<script id="configurator-data" type="application/json">{{ configurator | dump | safe }}</script>

{# UI strings embedded as JSON for client-side access #}
<script id="configurator-ui-strings" type="application/json">{{ en["configurator-ui"] | dump | safe }}</script>

{# Hidden Netlify Form for submission (must be in static HTML for Netlify detection) #}
<form id="configurator-form" name="vehicle-inquiry" method="POST"
      data-netlify="true" netlify-honeypot="bot-field" class="hidden"
      aria-hidden="true">
  <input type="hidden" name="form-name" value="vehicle-inquiry">
  <input type="hidden" name="bot-field">
  <input type="hidden" name="locale" value="en">
  <input type="hidden" name="configuration" id="form-configuration">
  <input type="text" name="name" aria-label="{{ en['configurator-ui']['form.name'] }}">
  <input type="email" name="email" aria-label="{{ en['configurator-ui']['form.email'] }}">
  <input type="tel" name="phone" aria-label="{{ en['configurator-ui']['form.phone'] }}">
  <input type="text" name="company" aria-label="{{ en['configurator-ui']['form.company'] }}">
  <textarea name="notes" aria-label="{{ en['configurator-ui']['form.notes'] }}"></textarea>
</form>

<div class="min-h-screen pt-20 bg-black" data-configurator data-locale="en">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12 py-12">

    {# Header #}
    <div class="mb-12">
      <h1 class="text-4xl lg:text-6xl font-bold tracking-wider uppercase mb-4">
        {{ en["configurator-ui"]["heading.title"] }}
      </h1>
      <p class="text-zinc-500 text-lg">{{ en["configurator-ui"]["heading.subtitle"] }}</p>
    </div>

    {# Step Indicator #}
    <div id="step-indicator" class="mb-12 border-b border-zinc-800 pb-8">
    </div>

    {# Main Layout: Content + Sidebar #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      {# Configuration Content (2/3 width on desktop) #}
      <div id="configurator-content" class="lg:col-span-2"
           aria-live="polite" aria-atomic="true">
        <noscript>
          <p class="text-zinc-400 text-lg">{{ en["configurator-ui"]["noscript.message"] }}</p>
        </noscript>
      </div>

      {# Sidebar (1/3 width on desktop) #}
      <aside id="configurator-sidebar" class="lg:col-span-1"
             aria-label="{{ en['configurator-ui']['aria.sidebar'] }}">
      </aside>
    </div>

    {# Navigation Buttons #}
    <div id="configurator-nav" class="sticky bottom-0 z-40 bg-black/95 backdrop-blur-md mt-12 flex justify-between items-center border-t border-zinc-800 pt-4 pb-4 -mx-6 px-6 lg:-mx-12 lg:px-12">
    </div>

    {# Notification Area for constraint messages #}
    <div id="configurator-notifications" role="status"
         aria-live="polite" aria-atomic="true"
         aria-label="{{ en['configurator-ui']['aria.notifications'] }}">
    </div>
  </div>
</div>

<script type="module" src="/assets/js/configurator/main.js"></script>

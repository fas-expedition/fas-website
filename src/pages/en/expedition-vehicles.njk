---
eleventyComputed:
  pageTitle: "{{ pageContent.expeditionsmobile.pageTitle }}"
  pageDescription: "{{ pageContent.expeditionsmobile.pageDescription }}"
altSlug:
  de: "expeditionsmobile"
  en: "expedition-vehicles"
---
{% from "macros/buttons.njk" import primaryBtn %}

{% set page = pageContent.expeditionsmobile %}

{# Hero Section #}
<section class="relative h-[50vh] flex items-center justify-center overflow-hidden bg-black">
  <div class="absolute inset-0 bg-cover bg-center z-0" style="background-image: url('/assets/images/vehicles/arocs-front.png')"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/10 z-0"></div>
  <div class="relative z-10 text-center px-6">
    <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-wider uppercase mb-6">{{ page.hero.title }}</h1>
    <p class="text-lg md:text-xl lg:text-2xl text-zinc-300">{{ page.hero.subtitle }}</p>
  </div>
</section>

{# Vehicle Type Sections #}
{% for vehicle in page.vehicleTypes %}
<section id="vehicle-{{ vehicle.id }}" class="relative {% if loop.index % 2 == 1 %}bg-black{% else %}bg-zinc-950{% endif %} py-3 lg:py-5">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {# Vehicle Image #}
      <div class="relative z-10 border border-zinc-800">
        <button 
          type="button"
          data-gallery-trigger="{{ vehicle.id }}" 
          class="block w-full hover:opacity-80 transition-opacity cursor-pointer bg-transparent border-0 p-0"
          aria-label="Open gallery for {{ vehicle.title }}">
          <img src="{{ vehicle.image }}" alt="{{ vehicle.title }}" class="w-full h-auto object-cover">
        </button>
      </div>

      {# Vehicle Details #}
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-3">{{ vehicle.title }}</h2>
        <p class="text-xl text-zinc-300 mb-8">{{ vehicle.subtitle }}</p>

        {# Specs Grid - 2x2 #}
        <div class="grid grid-cols-2 gap-6 mb-10">
          <div>
            <span class="text-zinc-500 text-xs tracking-widest uppercase block mb-1">{{ vehicle.specs.power.label }}</span>
            <span class="text-white font-bold">{{ vehicle.specs.power.value }}</span>
          </div>
          <div>
            <span class="text-zinc-500 text-xs tracking-widest uppercase block mb-1">{{ vehicle.specs.gvw.label }}</span>
            <span class="text-white font-bold">{{ vehicle.specs.gvw.value }}</span>
          </div>
          <div>
            <span class="text-zinc-500 text-xs tracking-widest uppercase block mb-1">{{ vehicle.specs.range.label }}</span>
            <span class="text-white font-bold">{{ vehicle.specs.range.value }}</span>
          </div>
          <div>
            <span class="text-zinc-500 text-xs tracking-widest uppercase block mb-1">{{ vehicle.specs.cabin.label }}</span>
            <span class="text-white font-bold">{{ vehicle.specs.cabin.value }}</span>
          </div>
        </div>

        {# Price Display #}
        <div class="mb-10">
          <div class="flex items-center gap-6">
            <span class="text-zinc-500 text-xl tracking-widest uppercase">Price from:</span>
            <span class="text-white text-xl font-bold">{{ vehicle.configurations[0].price }}</span>
          </div>
        </div>

        {# Thumbnail Gallery #}
        {% if vehicle.thumbGallery %}
        <div class="grid grid-cols-5 gap-3 mb-10">
          {% for image in vehicle.thumbGallery %}
          {% if loop.index0 < 5 %}
          <button 
            type="button"
            data-thumb-gallery="{{ vehicle.id }}" 
            data-thumb-index="{{ loop.index0 }}"
            class="gallery-thumb-trigger relative block w-full aspect-square hover:opacity-70 transition-opacity cursor-pointer border border-zinc-700 hover:border-zinc-500 overflow-hidden"
            aria-label="Open image">
            <img src="{{ image.url }}" alt="{{ image.alt }}" class="w-full h-full object-cover">
          </button>
          {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        {# CTA Button #}
        {% if "configurator" not in site.disabledNavItems %}
        {{ primaryBtn(vehicle.ctaText, vehicle.ctaUrl, true) }}
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endfor %}

{# Core Technologies Section #}
<section class="bg-zinc-950 py-24 lg:py-32">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-4">{{ page.coreTechnologies.title }}</h2>
      <p class="text-xl text-zinc-300">{{ page.coreTechnologies.subtitle }}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {% for item in page.coreTechnologies.items %}
      <div class="border border-zinc-800 hover:border-zinc-600 transition-colors p-8">
        <div class="text-white mb-4">
          {% if item.icon == "mountain" %}
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 18H4L12 3z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 14l2-3 2 2 3-4"></path>
          </svg>
          {% elif item.icon == "cog" %}
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {% elif item.icon == "shield" %}
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
          </svg>
          {% elif item.icon == "gauge" %}
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.24 7.76a6 6 0 010 8.49m-8.48-.01a6 6 0 010-8.49m11.31-2.82a10 10 0 010 14.14m-14.14 0a10 10 0 010-14.14"></path>
          </svg>
          {% endif %}
        </div>
        <h3 class="text-white text-sm font-bold tracking-widest uppercase mb-3">{{ item.title }}</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">{{ item.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Gallery Modals #}
{% for vehicle in page.vehicleTypes %}
<div id="gallery-{{ vehicle.id }}" class="gallery-modal hidden fixed inset-0 z-50 bg-black/95 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="gallery-title-{{ vehicle.id }}">
  <div class="w-full h-full max-w-6xl max-h-screen flex flex-col">
    {# Close Button #}
    <button class="gallery-close absolute top-6 right-6 text-white hover:text-zinc-300 transition-colors z-10" data-gallery-id="{{ vehicle.id }}" aria-label="Close gallery">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    {# Main Image Display with Navigation Arrows #}
    <div class="flex-1 flex items-center justify-center mb-6 gap-6 w-full" style="min-height: 0;">
      {# Previous Arrow #}
      <button class="gallery-prev text-white hover:text-zinc-300 transition-colors flex-shrink-0" data-gallery-id="{{ vehicle.id }}" aria-label="Previous image">
        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <div class="flex-1 flex items-center justify-center" style="aspect-ratio: 16/9; max-height: 70vh; min-height: 0;">
        <img id="gallery-image-{{ vehicle.id }}" src="" alt="" class="w-full h-full object-cover rounded-lg">
      </div>

      {# Next Arrow #}
      <button class="gallery-next text-white hover:text-zinc-300 transition-colors flex-shrink-0" data-gallery-id="{{ vehicle.id }}" aria-label="Next image">
        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

    {# Thumbnail Grid #}
    <div class="flex gap-2 justify-center overflow-x-auto px-4 mb-4" id="gallery-thumbnails-{{ vehicle.id }}">
      {% for image in vehicle.gallery %}
      <button 
        class="gallery-thumbnail w-16 h-16 flex-shrink-0 border-2 border-transparent hover:border-white transition-colors rounded"
        data-gallery-id="{{ vehicle.id }}"
        data-index="{{ loop.index0 }}"
        aria-label="Image {{ loop.index }} of {{ vehicle.gallery | length }}">
        <img src="{{ image.url }}" alt="{{ image.alt }}" class="w-full h-full object-cover rounded">
      </button>
      {% endfor %}
    </div>

    {# Image Counter #}
    <p class="text-center text-zinc-400 text-sm mt-4" id="gallery-counter-{{ vehicle.id }}"></p>
  </div>
</div>
{% endfor %}

{# Inquiry CTA Section #}
<section class="bg-black py-20 lg:py-28">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="text-center">
      <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-6">Find Your Perfect Expedition Vehicle</h2>
      <p class="text-lg text-zinc-300 mb-10 max-w-2xl mx-auto">Contact our team to discover which configuration meets your requirements.</p>
      {{ primaryBtn("Request Information", "#inquiry-form", true) }}
    </div>
  </div>
</section>

---
eleventyComputed:
  pageTitle: "{{ pageContent['modular-systems'].pageTitle }}"
  pageDescription: "{{ pageContent['modular-systems'].pageDescription }}"
  altSlug:
    de: "{{ pageContent['modular-systems'].altSlug.de }}"
    en: "{{ pageContent['modular-systems'].altSlug.en }}"
---

{% from "macros/buttons.njk" import primaryBtn %}
{% set page = pageContent["modular-systems"] %}

{% include "partials/lightbox-modal.njk" %}

{# Hero Section #}
<section class="relative h-[50vh] flex items-center justify-center overflow-hidden bg-black">
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/assets/images/vehicles/expedition-hero.png')"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/10"></div>
  <div class="relative z-10 text-center px-6">
    <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-wider uppercase mb-6">{{ page.hero.title }}</h1>
    <p class="text-lg md:text-xl lg:text-2xl text-zinc-300">{{ page.hero.subtitle }}</p>
  </div>
</section>

{# System Overview Section #}
<section class="bg-zinc-950 py-32">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      {# Left Column: Description #}
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-8">{{ page.overview.title }}</h2>
        <p class="text-zinc-300 text-lg mb-8 leading-relaxed">{{ page.overview.description }}</p>
        <ul class="space-y-4 mb-10">
          {% for feature in page.overview.features %}
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-white mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-zinc-300">{{ feature }}</span>
          </li>
          {% endfor %}
        </ul>
        {{ primaryBtn(page.overview.ctaText, page.overview.ctaUrl, true) }}
      </div>

      {# Right Column: Product Image #}
      <div>
        <img src="/assets/images/modules/HT XL mit Plattformen.png" alt="Rear carrier system with platforms" class="w-full h-auto relative hover-above-logo" loading="lazy" width="600" height="600">
      </div>
    </div>
  </div>
</section>

{# Available Modules Section #}
<section class="bg-black py-32">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-4">{{ page.modules.title }}</h2>
      <p class="text-zinc-400 text-lg">{{ page.modules.subtitle }}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {% for module in page.modules.items %}
      <div class="group overflow-hidden relative flex flex-col">
        {# Module Image #}
        <div class="relative overflow-hidden bg-black mb-6 aspect-video flex items-center justify-center">
          <img src="{{ module.image }}" alt="{{ module.title }}" data-lightbox data-caption="{{ module.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
        </div>
        {# Module Content #}
        <div>
          <h3 class="text-2xl font-bold uppercase tracking-wider mb-3">{{ module.title }}</h3>
          <p class="text-zinc-400 mb-4 leading-relaxed">{{ module.description }}</p>
          <a href="#inquiry-form" class="text-white hover:text-zinc-300 transition-colors font-semibold uppercase tracking-wider inline-flex items-center">
            Learn More
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="flex justify-center mt-16">
      {{ primaryBtn("Request Now", "#inquiry-form", true) }}
    </div>
  </div>
</section>

{# Featured CTA Section #}
<section class="bg-zinc-950 py-32">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      {# Left Column: Content #}
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-8">{{ page.featuredSection.title }}</h2>
        <p class="text-zinc-300 text-lg mb-8 leading-relaxed">{{ page.featuredSection.description }}</p>
        <ul class="space-y-4 mb-10">
          {% for feature in page.featuredSection.features %}
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-white mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-zinc-300">{{ feature }}</span>
          </li>
          {% endfor %}
        </ul>
        {{ primaryBtn(page.featuredSection.ctaText, page.featuredSection.ctaUrl, true) }}
      </div>

      {# Right Column: Image #}
      <div class="overflow-hidden">
        <img src="{{ page.featuredSection.image }}" alt="{{ page.featuredSection.title }}" class="w-full h-full object-contain relative hover-above-logo" loading="lazy" width="600" height="600">
      </div>
    </div>
  </div>
</section>

{# Additional CTA Section #}
<section class="bg-black py-32">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      {# Left Column: Image #}
      <div>
        <img src="{{ page.additionalSection.image }}" alt="{{ page.additionalSection.title }}" class="w-full h-auto" loading="lazy" width="600" height="600">
      </div>

      {# Right Column: Content #}
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-8">{{ page.additionalSection.title }}</h2>
        <p class="text-zinc-300 text-lg mb-8 leading-relaxed">{{ page.additionalSection.description }}</p>
        <ul class="space-y-4 mb-10">
          {% for feature in page.additionalSection.features %}
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-white mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-zinc-300">{{ feature }}</span>
          </li>
          {% endfor %}
        </ul>
        {{ primaryBtn(page.additionalSection.ctaText, page.additionalSection.ctaUrl, true) }}
      </div>
    </div>
  </div>
</section>

{% set page = pageContent.contact %}
{% set form = page.form %}

<section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-zinc-950"></div><div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/10"></div>
  <div class="relative z-10 text-center px-6">
    <h1 class="text-3xl md:text-5xl lg:text-7xl font-bold tracking-wider uppercase mb-6">{{ page.hero.title }}</h1>
    <p class="text-xl lg:text-2xl text-zinc-300">{{ page.hero.subtitle }}</p>
  </div>
</section>

<section class="bg-zinc-950 py-24 lg:py-32">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <h2 class="text-3xl font-bold tracking-wider uppercase mb-4">{{ form.title }}</h2>
        <p class="text-zinc-400 text-sm mb-8">{{ form.intro }}</p>
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" class="space-y-6">
          <p class="hidden"><label>{{ form.honeypot }} <input name="bot-field"></label></p>
          <div>
            <label for="name" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ form.name }}</label>
            <input type="text" id="name" name="name" required class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600" placeholder="{{ form.namePlaceholder }}">
          </div>
          <div>
            <label for="email" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ form.email }}</label>
            <input type="email" id="email" name="email" required class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600" placeholder="{{ form.emailPlaceholder }}">
          </div>
          <div>
            <label for="phone" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ form.phone }}</label>
            <input type="tel" id="phone" name="phone" class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600" placeholder="+49 ...">
          </div>
          <div>
            <label for="file" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ form.file }}</label>
            <input type="file" id="file" name="file" multiple accept=".pdf,.doc,.docx,.jpg,.png" class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm file:mr-4 file:py-1 file:px-3 file:border file:border-zinc-700 file:text-xs file:uppercase file:tracking-widest file:font-bold file:bg-transparent file:text-zinc-400 file:hover:text-white file:transition-colors file:cursor-pointer">
          </div>
          <div>
            <label for="message" class="block text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ form.message }}</label>
            <textarea id="message" name="message" rows="6" required class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-white focus:outline-none transition-colors placeholder-zinc-600 resize-y" placeholder="{{ form.messagePlaceholder }}"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center space-x-3 bg-white text-black px-10 py-4 text-sm tracking-widest uppercase font-bold hover:bg-zinc-200 transition-colors">
            <span>{{ form.submit }}</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </button>
        </form>
      </div>
      <div>
        <h2 class="text-3xl font-bold tracking-wider uppercase mb-8">{{ page.details.title }}</h2>
        <div class="space-y-6 mb-12">
          <div class="border border-zinc-800 p-6"><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.details.phoneLabel }}</p><a href="tel:+4924739293422" class="text-white font-bold hover:text-zinc-300 transition-colors">{{ page.details.phone }}</a></div>
          <div class="border border-zinc-800 p-6"><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.details.emailLabel }}</p><a href="mailto:{{ page.details.email }}" class="text-white font-bold hover:text-zinc-300 transition-colors">{{ page.details.email }}</a></div>
          <div class="border border-zinc-800 p-6"><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.details.addressLabel }}</p><p class="text-white font-bold">{{ page.details.company }}</p><p class="text-zinc-400 mt-1">{{ page.details.address | join("<br>") | safe }}</p></div>
          <div class="border border-zinc-800 p-6"><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.details.visitLabel }}</p><p class="text-zinc-300 text-sm">{{ page.details.visitText }}</p></div>
        </div>
      </div>
      <div id="impressum">
        <h2 class="text-3xl font-bold tracking-wider uppercase mb-8">{{ page.legal.title }}</h2>
        <div class="space-y-6 text-zinc-300 text-sm leading-relaxed">
          <div><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.legal.responsible }}</p><p class="text-white">FAS Expedition GmbH</p><p>Trafoweg 2-4<br>52152 Lammersdorf / Allemagne</p><p class="mt-2">{{ page.legal.representative }}<br>{{ page.legal.managingDirector }}</p></div>
          <div><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.legal.contact }}</p><p>info@fas-expedition.de<br>+49 (0) 2473 929 3422</p></div>
          <div><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.legal.register }}</p><p>{{ page.legal.registerValue }}</p></div>
          <div><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.legal.disclaimer }}</p><p>{{ page.legal.disclaimerText }}</p></div>
          <div><p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.legal.vat }}</p><p>{{ page.legal.vatValue }}</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

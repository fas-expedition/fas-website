---
eleventyComputed:
  pageTitle: "{{ pageContent['modular-systems'].pageTitle }}"
  pageDescription: "{{ pageContent['modular-systems'].pageDescription }}"
  altSlug:
    de: "{{ pageContent['modular-systems'].altSlug.de }}"
    en: "{{ pageContent['modular-systems'].altSlug.en }}"
---

{% from "macros/buttons.njk" import primaryBtn %}
{% set page = pageContent["modular-systems"] %}

{# Hero Section #}
<section class="relative h-[70vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0">
    <img src="{{ page.hero.image }}" alt="{{ page.hero.title }}" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black"></div>
  </div>
  <div class="relative z-10 text-center px-6">
    <h1 class="text-5xl lg:text-7xl font-bold tracking-wider uppercase mb-6">{{ page.hero.title }}</h1>
    <p class="text-xl lg:text-2xl text-zinc-300">{{ page.hero.subtitle }}</p>
  </div>
</section>

{# System Overview Section #}
<section class="bg-zinc-950 py-32">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      {# Left Column: Description #}
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-8">{{ page.overview.title }}</h2>
        <p class="text-zinc-300 text-lg mb-8 leading-relaxed">{{ page.overview.description }}</p>
        <ul class="space-y-4 mb-10">
          {% for feature in page.overview.features %}
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-white mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-zinc-300">{{ feature }}</span>
          </li>
          {% endfor %}
        </ul>
        {{ primaryBtn(page.overview.ctaText, page.overview.ctaUrl, true) }}
      </div>

      {# Right Column: Stats Grid #}
      <div class="grid grid-cols-2 gap-6">
        {% for stat in page.stats %}
        <div class="border border-zinc-800 p-6">
          <p class="text-3xl font-bold text-white mb-2">{{ stat.value }}</p>
          <p class="text-sm uppercase tracking-widest font-bold text-zinc-300 mb-1">{{ stat.label }}</p>
          <p class="text-sm text-zinc-500">{{ stat.description }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# Available Modules Section #}
<section class="bg-black py-32">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase mb-4">{{ page.modules.title }}</h2>
      <p class="text-zinc-400 text-lg">{{ page.modules.subtitle }}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for module in page.modules.items %}
      <div class="border border-zinc-800 hover:border-zinc-600 transition-colors p-6">
        <p class="text-xs uppercase tracking-widest text-zinc-400 mb-2">{{ module.category }}</p>
        <h3 class="text-lg font-bold uppercase tracking-wider mb-4">{{ module.title }}</h3>
        <div class="space-y-3 text-sm">
          <div>
            <p class="text-zinc-500 mb-1">Sizes</p>
            <ul class="space-y-1">
              {% for size in module.sizes %}
              <li class="text-zinc-300">{{ size }}</li>
              {% endfor %}
            </ul>
          </div>
          <div>
            <p class="text-zinc-500">Load Capacity</p>
            <p class="text-zinc-300">{{ module.loadCapacity }}</p>
          </div>
          <div>
            <p class="text-zinc-500">Material</p>
            <p class="text-zinc-300">{{ module.material }}</p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

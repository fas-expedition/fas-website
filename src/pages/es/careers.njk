{% from "macros/buttons.njk" import primaryBtn %}
{% set page = pageContent.careers %}

<section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-zinc-950"></div><div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/10"></div>
  <div class="relative z-10 text-center px-6">
    <h1 class="text-3xl md:text-5xl lg:text-7xl font-bold tracking-wider uppercase mb-6">{{ page.hero.title }}</h1>
    <p class="text-xl lg:text-2xl text-zinc-300 max-w-3xl mx-auto">{{ page.hero.subtitle }}</p>
  </div>
</section>

<section class="bg-zinc-950 py-24">
  <div class="max-w-[1000px] mx-auto px-6 lg:px-12">
    {% for paragraph in page.intro.split("\n\n") %}<p class="text-zinc-300 text-lg leading-relaxed {% if not loop.last %}mb-8{% endif %}">{{ paragraph }}</p>{% endfor %}
  </div>
</section>

{% for job in page.jobs %}
<section id="{{ job.title | slugify }}" class="{% if loop.index is odd %}bg-black{% else %}bg-zinc-950{% endif %} py-24 lg:py-32 border-t border-zinc-900">
  <div class="max-w-[1000px] mx-auto px-6 lg:px-12">
    <div class="mb-8">
      <span class="text-xs uppercase tracking-widest text-zinc-500 mb-2 block">{{ page.labels.jobOpening }}</span>
      <h2 class="text-3xl lg:text-4xl font-bold tracking-wider uppercase">{{ job.title }}</h2>
      <p class="text-zinc-400 mt-2">{{ page.labels.location }}: {{ job.location }} · {{ page.labels.division }}: {{ job.division }}</p>
    </div>
    <div class="space-y-8 text-zinc-300 leading-relaxed">
      {% for group in [{ "title": page.labels.tasks, "items": job.tasks }, { "title": page.labels.profile, "items": job.profile }, { "title": page.labels.benefits, "items": job.benefits }] %}
      <div>
        <h3 class="text-white font-bold uppercase tracking-wider text-sm mb-4">{{ group.title }}</h3>
        <ul class="space-y-3">{% for item in group.items %}<li class="flex items-start space-x-3"><span class="text-white mt-1">•</span><span>{{ item }}</span></li>{% endfor %}</ul>
      </div>
      {% endfor %}
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      {{ primaryBtn(job.ctaText, job.ctaUrl, true) }}
      {% if job.pdfUrl %}
      <a href="{{ job.pdfUrl }}" target="_blank" rel="noopener" class="inline-flex items-center space-x-2 border border-zinc-700 hover:bg-white hover:text-black px-10 py-4 text-sm tracking-widest uppercase font-bold transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>{{ page.labels.pdf }}</span>
      </a>
      {% endif %}
    </div>
  </div>
</section>
{% endfor %}

<section class="bg-black py-24 lg:py-32 border-t border-zinc-900">
  <div class="max-w-[800px] mx-auto px-6 lg:px-12 text-center">
    <h2 class="text-3xl font-bold tracking-wider uppercase mb-6">{{ page.applicationCta.title }}</h2>
    <p class="text-zinc-300 text-lg leading-relaxed mb-4">{{ page.applicationCta.description }}</p>
    <div class="border border-zinc-800 p-8 mb-10 text-left">
      <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">{{ page.labels.contactDirectly }}</p>
      <p class="text-white font-bold">{{ page.applicationCta.contactName }}</p>
      <p class="text-zinc-400 mt-1">{{ page.applicationCta.contactCompany }}<br>{{ page.applicationCta.contactAddress | replace("\n", "<br>") | safe }}</p>
      <a href="mailto:{{ page.applicationCta.contactEmail }}" class="text-white underline hover:text-zinc-300 transition-colors mt-3 inline-block">{{ page.applicationCta.contactEmail }}</a>
    </div>
    {{ primaryBtn(page.applicationCta.ctaText, page.applicationCta.ctaUrl, true) }}
  </div>
</section>

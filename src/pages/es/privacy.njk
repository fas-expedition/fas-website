{% from "macros/buttons.njk" import secondaryBtn %}
{% set page = pageContent.privacy %}

<section class="min-h-screen flex items-center justify-center px-6">
  <div class="text-center">
    <h1 class="text-2xl md:text-4xl lg:text-6xl font-bold tracking-wider uppercase text-center">{{ page.title }}</h1>
    <p class="mt-6 text-lg text-zinc-300 max-w-2xl mx-auto">{{ page.notice }}</p>
    <div class="mt-10 space-y-4">
      {{ secondaryBtn(page.sourceLink, "/de/datenschutz/") }}
      <div>{{ secondaryBtn(page.backHome, "/" + locale + "/") }}</div>
    </div>
  </div>
</section>

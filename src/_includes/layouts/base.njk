<!DOCTYPE html>
<html lang="{{ locale }}" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }} | FAS Expedition</title>
  <meta name="description" content="{{ pageDescription }}">
  
  {# Canonical Tag #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  
  {# Hreflang for Multi-language #}
  <link rel="alternate" hreflang="de" href="{{ site.url }}/de/{{ altSlug.de if altSlug else '' }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}/en/{{ altSlug.en if altSlug else '' }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/de/{{ altSlug.de if altSlug else '' }}">
  
  {# Open Graph Tags #}
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:site_name" content="FAS Expedition">
  <meta property="og:locale" content="{{ 'de_DE' if locale == 'de' else 'en_GB' }}">
  {% if locale == 'de' %}
  <meta property="og:locale:alternate" content="en_GB">
  {% else %}
  <meta property="og:locale:alternate" content="de_DE">
  {% endif %}
  
  {# Twitter Card Tags #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:site" content="@fasexpedition">
  
  {# Mobile Optimization #}
  <meta name="theme-color" content="#000000">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="FAS Expedition">
  
  {# Favicon #}
  <link rel="icon" type="image/png" href="/assets/favicon/favicon.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/assets/favicon/favicon.png">
  <link rel="shortcut icon" href="/assets/favicon/favicon.png" type="image/png">
  
  {# Additional SEO #}
  <meta name="robots" content="index, follow">
  <meta name="language" content="{{ 'German' if locale == 'de' else 'English' }}">
  
  <link rel="stylesheet" href="/assets/css/output.css">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  
  {# JSON-LD Structured Data #}
  {% include "partials/schema.njk" %}
</head>
<body class="bg-black text-white font-sans antialiased">
  {# Logo Background #}
  <div class="fixed top-0 right-0 h-screen pointer-events-none z-0 opacity-25" style="width: 1000px;">
    <img src="/assets/downloads/Logos/halber Wolfskopf-1.svg" alt="" class="h-full w-auto ml-auto" style="position: relative; right: 0; top: 0;" eleventy:ignore>
  </div>

  {% include "partials/navigation.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% if locale == 'de' or locale == 'en' %}
  <style>
    #mobile-banner-popup {
      display: none;
    }

    @media (max-width: 767px) {
      #desktop-floating-banner {
        display: none;
      }

      #mobile-banner-popup {
        display: flex;
      }
    }
  </style>
  <div id="mobile-banner-popup" class="fixed inset-0 z-[60] items-center justify-center bg-black/60 p-4" aria-label="Banner popup">
    <div class="relative w-full" style="max-width: min(360px, calc(100vw - 2rem));">
      <button
        id="mobile-banner-close"
        type="button"
        class="absolute -right-2 -top-2 flex h-8 w-8 items-center justify-center rounded-full border border-white/20 bg-black/80 text-xl font-bold text-white shadow-lg transition hover:bg-white hover:text-black"
        aria-label="{% if locale == 'de' %}Banner schließen{% else %}Close banner{% endif %}"
      >
        ×
      </button>
      <img
        src="/assets/downloads/Logos/halfpage-banner-de.jpg"
        alt=""
        class="block w-full rounded-md border border-white/10 shadow-2xl shadow-black/50"
        style="height: auto; max-height: calc(100dvh - 3rem); object-fit: contain;"
      >
    </div>
  </div>

  <div id="desktop-floating-banner" class="pointer-events-none fixed bottom-5 right-5 z-50" aria-hidden="true">
    <div
      class="pointer-events-auto w-[110px] sm:w-[140px] lg:w-[180px] xl:w-[220px] rounded-md border border-white/10 shadow-2xl shadow-black/50 bg-cover bg-center"
      style="aspect-ratio: 1/2; background-image: url('/assets/downloads/Logos/halfpage-banner-de.jpg');"
    ></div>
  </div>
  {% endif %}
  {% include "partials/footer.njk" %}
  {% include "partials/inquiry-form-modal.njk" %}

  <script>
    // Handle Identity Widget redirect after email confirmation
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function(user) {
        if (!user) {
          window.netlifyIdentity.on("login", function() {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
  <script>
    (function() {
      var nav = document.querySelector('nav');
      var menuBtn = document.getElementById('menu-toggle');
      var mobileMenu = document.getElementById('mobile-menu');
      var mobileBannerPopup = document.getElementById('mobile-banner-popup');
      var mobileBannerClose = document.getElementById('mobile-banner-close');

      // Scroll detection for nav transparency
      function onScroll() {
        if (window.scrollY > 50) {
          nav.classList.add('bg-zinc-900/95', 'backdrop-blur-md', 'shadow-lg');
          nav.classList.remove('bg-transparent');
        } else {
          nav.classList.remove('bg-zinc-900/95', 'backdrop-blur-md', 'shadow-lg');
          nav.classList.add('bg-transparent');
        }
      }
      window.addEventListener('scroll', onScroll);
      onScroll();

      // Mobile menu toggle
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', function() {
          mobileMenu.classList.toggle('hidden');
          const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
          menuBtn.setAttribute('aria-expanded', !isExpanded);
        });
      }

      if (mobileBannerPopup && mobileBannerClose) {
        mobileBannerClose.addEventListener('click', function() {
          mobileBannerPopup.style.display = 'none';
        });
      }
    })();
  </script>
  <script src="/assets/js/inquiry-pdf.js"></script>
  <script src="/assets/js/inquiry-form.js"></script>
  <script src="/assets/js/lazy-loading.js"></script>
  <script src="/assets/js/gallery.js"></script>
  <script src="/assets/js/contact-form.js"></script>
</body>
</html>

{% set items = [
  ["index", "home"], ["expedition-vehicles", "expeditionMobile"],
  ["modular-systems", "modularSystems"], ["brabus", "brabus"],
  ["configurator", "configurator"], ["blog", "blog"], ["about", "about"]
] %}
{% macro navLinks(classes) %}
  {% for item in items %}
    {% set key = item[0] %}
    {% if key not in site.disabledNavItems %}
      {% set url = localizedRoutes[key] %}
      <a href="{{ url }}" class="{{ classes }} uppercase font-bold transition-colors {% if page.url == url %}text-green-500{% elif key != 'brabus' %}text-white hover:text-zinc-300{% endif %}"{% if key == 'brabus' %} style="font-family: Georgia, serif;{% if page.url != url %} color: rgb(204, 69, 61);{% endif %}"{% endif %}>
        {{ translations["nav." + item[1]] }}
      </a>
    {% endif %}
  {% endfor %}
{% endmacro %}
{% macro loginLink(classes) %}
  <a href="/admin/" class="{{ classes }} items-center space-x-2 border border-zinc-700 hover:bg-white hover:text-black px-4 py-2 text-sm tracking-widest uppercase font-bold transition-all">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
    </svg>
    <span>{{ translations["nav.customerPortal"] }}</span>
  </a>
{% endmacro %}

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-8 h-20">
      <a href="{{ localizedRoutes.index }}" class="flex-shrink-0">
        <img src="/assets/images/logo/fas-logo-white.png" alt="FAS Expedition" class="h-10 w-auto">
      </a>
      <div class="hidden xl:flex items-center gap-6 flex-1">
        {{ navLinks("text-sm tracking-wider") }}
      </div>
      <div class="flex items-center gap-4 ml-auto">
        <a href="tel:+491517217119" class="hidden 2xl:flex items-center text-xs font-bold uppercase tracking-widest text-white hover:text-zinc-300 whitespace-nowrap">
          {{ translations["nav.sales"] }} +49 151 7217 11 99
        </a>
        {{ loginLink("hidden xl:inline-flex") }}
        <div class="hidden lg:flex max-xl:hidden items-center border border-zinc-700 divide-x divide-zinc-700">
          {% include "partials/language-links.njk" %}
        </div>
        <button id="menu-toggle" class="xl:hidden flex items-center justify-center w-10 h-10 text-white" aria-label="{{ translations['nav.openMenu'] }}" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="hidden xl:hidden bg-black/98 backdrop-blur-md border-t border-zinc-800">
    <div class="px-6 py-8 space-y-6">
      {{ navLinks("block text-xs md:text-sm tracking-wider md:tracking-widest") }}
      <div class="border-t border-zinc-800 pt-6 space-y-6">
        <div class="flex items-center border border-zinc-700 divide-x divide-zinc-700 w-fit">
          {% include "partials/language-links.njk" %}
        </div>
        {{ loginLink("inline-flex") }}
      </div>
    </div>
  </div>
</nav>

{# Navigation Partial #}
{% set altLocale = "en" if locale == "de" else "de" %}
{% set altLink = "/" + altLocale + "/" + (altSlug[altLocale] if altSlug else "") %}

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300">
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-8 h-20">

      {# FAS Logo #}
      <a href="/{{ locale }}/" class="flex-shrink-0">
        <img src="/assets/images/logo/fas-logo-white.png" alt="FAS Expedition" class="h-10 w-auto">
      </a>

      {# Desktop Navigation Links #}
      <div class="hidden lg:flex items-center gap-8 flex-1">
        <a href="/{{ locale }}/" class="text-sm tracking-widest uppercase font-bold transition-colors {% if page.url == '/' + locale + '/' %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
          {{ translations["nav.home"] }}
        </a>
        <a href="/{{ locale }}/{% if locale == 'de' %}expeditionsmobile{% else %}expedition-vehicles{% endif %}/" class="text-sm tracking-widest uppercase font-bold transition-colors {% if '/expeditionsmobile/' in page.url or '/expedition-vehicles/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
          {{ translations["nav.expeditionMobile"] }}
        </a>
        <a href="/{{ locale }}/{% if locale == 'de' %}modulare-systeme{% else %}modular-systems{% endif %}/" class="text-sm tracking-widest uppercase font-bold transition-colors {% if '/modulare-systeme/' in page.url or '/modular-systems/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
          {{ translations["nav.modularSystems"] }}
        </a>
        {% if "brabus" not in site.disabledNavItems %}
        <a href="/{{ locale }}/brabus/" class="text-sm tracking-widest uppercase font-bold transition-opacity {% if '/brabus/' in page.url %}text-green-500{% else %}hover:opacity-80{% endif %}" style="font-family: 'Georgia', serif; {% if '/brabus/' not in page.url %}color: rgb(204, 69, 61){% endif %};">
          {{ translations["nav.brabus"] }}
        </a>
        {% endif %}
        {% if "configurator" not in site.disabledNavItems %}
        <a href="/{{ locale }}/{% if locale == 'de' %}konfigurator{% else %}configurator{% endif %}/" class="text-sm tracking-widest uppercase font-bold transition-colors {% if '/konfigurator/' in page.url or '/configurator/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
          {{ translations["nav.configurator"] }}
        </a>
        {% endif %}
        <a href="/{{ locale }}/blog/" class="text-sm tracking-widest uppercase font-bold transition-colors {% if '/blog/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
          {{ translations["nav.blog"] }}
        </a>
        <a href="/{{ locale }}/{% if locale == 'de' %}ueber-uns{% else %}about{% endif %}/" class="text-sm tracking-widest uppercase font-bold transition-colors {% if '/ueber-uns/' in page.url or '/about/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
          {{ translations["nav.about"] }}
        </a>
      </div>

      {# Right Side: Login + Language Switcher + Mobile Toggle #}
      <div class="flex items-center gap-4 ml-auto">

        {# Phone Number #}
        <a href="tel:+491517217119" class="hidden lg:flex items-center text-xs font-bold uppercase tracking-widest text-white hover:text-zinc-300 transition-colors whitespace-nowrap">
          {% if locale == "de" %}Vertrieb{% else %}Sales{% endif %} +49 151 7217 11 99
        </a>

        {# LOGIN Button #}
        <a href="/admin/" class="hidden lg:inline-flex items-center space-x-2 border border-zinc-700 hover:bg-white hover:text-black px-6 py-2.5 text-sm tracking-widest uppercase font-bold transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
          </svg>
          <span>{{ translations["nav.customerPortal"] }}</span>
        </a>

        {# Language Switcher #}
        <div class="hidden lg:flex items-center border border-zinc-700 divide-x divide-zinc-700">
          <a href="{% if locale == 'de' %}/de/{{ altSlug.de if altSlug else '' }}{% else %}{{ altLink }}{% endif %}"
             class="px-3 py-0 text-xs font-bold uppercase transition-colors {% if locale == 'de' %}bg-white text-black{% else %}text-zinc-400 hover:text-white{% endif %}">
            DE
          </a>
          <a href="{% if locale == 'en' %}/en/{{ altSlug.en if altSlug else '' }}{% else %}{{ altLink }}{% endif %}"
             class="px-3 py-0 text-xs font-bold uppercase transition-colors {% if locale == 'en' %}bg-white text-black{% else %}text-zinc-400 hover:text-white{% endif %}">
            EN
          </a>
        </div>

        {# Mobile Hamburger Button #}
        <button id="menu-toggle" class="lg:hidden flex items-center justify-center w-10 h-10 text-white" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {# Mobile Menu Dropdown #}
  <div id="mobile-menu" class="hidden lg:hidden bg-black/98 backdrop-blur-md border-t border-zinc-800">
    <div class="px-6 py-8 space-y-6">
      {# Mobile Nav Links #}
      <a href="/{{ locale }}/" class="block text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-colors {% if page.url == '/' + locale + '/' %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
        {{ translations["nav.home"] }}
      </a>
      <a href="/{{ locale }}/{% if locale == 'de' %}expeditionsmobile{% else %}expedition-vehicles{% endif %}/" class="block text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-colors {% if '/expeditionsmobile/' in page.url or '/expedition-vehicles/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
        {{ translations["nav.expeditionMobile"] }}
      </a>
      <a href="/{{ locale }}/{% if locale == 'de' %}modulare-systeme{% else %}modular-systems{% endif %}/" class="block text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-colors {% if '/modulare-systeme/' in page.url or '/modular-systems/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
        {{ translations["nav.modularSystems"] }}
      </a>
      {% if "brabus" not in site.disabledNavItems %}
      <a href="/{{ locale }}/brabus/" class="block text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-opacity {% if '/brabus/' in page.url %}text-green-500{% else %}hover:opacity-80{% endif %}" style="font-family: 'Georgia', serif; {% if '/brabus/' not in page.url %}color: rgb(204, 69, 61){% endif %};">
        {{ translations["nav.brabus"] }}
      </a>
      {% endif %}
      {% if "configurator" not in site.disabledNavItems %}
      <a href="/{{ locale }}/{% if locale == 'de' %}konfigurator{% else %}configurator{% endif %}/" class="block text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-colors {% if '/konfigurator/' in page.url or '/configurator/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
        {{ translations["nav.configurator"] }}
      </a>
      {% endif %}
      <a href="/{{ locale }}/blog/" class="block text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-colors {% if '/blog/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
        {{ translations["nav.blog"] }}
      </a>
      <a href="/{{ locale }}/{% if locale == 'de' %}ueber-uns{% else %}about{% endif %}/" class="block text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-colors {% if '/ueber-uns/' in page.url or '/about/' in page.url %}text-green-500{% else %}text-white hover:text-zinc-300{% endif %}">
        {{ translations["nav.about"] }}
      </a>

      {# Mobile Divider #}
      <div class="border-t border-zinc-800 pt-6 space-y-6">
        {# Mobile Language Switcher #}
        <div class="flex items-center border border-zinc-700 divide-x divide-zinc-700 w-fit">
          <a href="{% if locale == 'de' %}/de/{{ altSlug.de if altSlug else '' }}{% else %}/de/{% endif %}"
             class="px-4 py-2 text-xs font-bold uppercase transition-colors {% if locale == 'de' %}bg-white text-black{% else %}text-zinc-400 hover:text-white{% endif %}">
            DE
          </a>
          <a href="{% if locale == 'en' %}/en/{{ altSlug.en if altSlug else '' }}{% else %}/en/{% endif %}"
             class="px-4 py-2 text-xs font-bold uppercase transition-colors {% if locale == 'en' %}bg-white text-black{% else %}text-zinc-400 hover:text-white{% endif %}">
            EN
          </a>
        </div>

        {# Mobile LOGIN Button #}
        <a href="/admin/" class="inline-flex items-center space-x-2 border border-zinc-700 hover:bg-white hover:text-black px-4 md:px-6 py-2 md:py-3 text-xs md:text-sm tracking-wider md:tracking-widest uppercase font-bold transition-all">
          <svg class="w-3 h-3 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
          </svg>
          <span>{{ translations["nav.customerPortal"] }}</span>
        </a>
      </div>
    </div>
  </div>
</nav>

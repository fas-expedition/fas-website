{# Inquiry Form Modal #}
<div id="inquiry-form" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-zinc-900 border border-zinc-800 rounded-lg max-w-2xl w-full my-8 flex flex-col max-h-[90vh]">
    
    {# Header #}
    <div class="flex items-center justify-between border-b border-zinc-800 p-6 flex-shrink-0">
      <h2 class="text-2xl font-bold tracking-wider uppercase">
        {% if locale == "de" %}Anfrage stellen{% else %}Inquiry Form{% endif %}
      </h2>
      <button class="inquiry-form-close text-zinc-400 hover:text-white transition-colors" aria-label="Close form">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {# Form Content #}
    <form id="inquiry-form-element" class="p-6 space-y-6 overflow-y-auto flex-1">
      {# Hidden form-name for Netlify Forms detection #}
      <input type="hidden" name="form-name" value="inquiry" />
      
      {# Name #}
      <div>
        <label for="inquiry-name" class="block text-sm font-semibold uppercase tracking-wider mb-2">
          {% if locale == "de" %}Name{% else %}Name{% endif %} <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="inquiry-name"
          name="name"
          required
          class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
          placeholder="{% if locale == 'de' %}Ihr Name{% else %}Your Name{% endif %}"
        />
      </div>

      {# Address #}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="inquiry-street" class="block text-sm font-semibold uppercase tracking-wider mb-2">
            {% if locale == "de" %}Straße & Hausnummer{% else %}Street & Number{% endif %}
          </label>
          <input
            type="text"
            id="inquiry-street"
            name="street"
            required
            class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
            placeholder="{% if locale == 'de' %}Straße{% else %}Street{% endif %}"
          />
        </div>
        <div>
          <label for="inquiry-postal" class="block text-sm font-semibold uppercase tracking-wider mb-2">
            {% if locale == "de" %}PLZ & Ort{% else %}Postal & City{% endif %}
          </label>
          <input
            type="text"
            id="inquiry-postal"
            name="postal"
            required
            class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
            placeholder="{% if locale == 'de' %}12345 Stadt{% else %}12345 City{% endif %}"
          />
        </div>
        <div class="md:col-span-2">
          <label for="inquiry-country" class="block text-sm font-semibold uppercase tracking-wider mb-2">
            {% if locale == "de" %}Land{% else %}Country{% endif %}
          </label>
          <input
            type="text"
            id="inquiry-country"
            name="country"
            required
            class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
            placeholder="{% if locale == 'de' %}Deutschland{% else %}Country{% endif %}"
          />
        </div>
      </div>

      {# Contact Details #}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="inquiry-email" class="block text-sm font-semibold uppercase tracking-wider mb-2">
            E-Mail <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="inquiry-email"
            name="email"
            required
            class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
            placeholder="name@example.com"
          />
        </div>
        <div>
          <label for="inquiry-phone" class="block text-sm font-semibold uppercase tracking-wider mb-2">
            {% if locale == "de" %}Telefon{% else %}Phone{% endif %} <span class="text-red-500">*</span>
          </label>
          <input
            type="tel"
            id="inquiry-phone"
            name="phone"
            required
            class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
            placeholder="+49 (0) 123 456789"
          />
        </div>
      </div>

      {# Message #}
      <div>
        <label for="inquiry-message" class="block text-sm font-semibold uppercase tracking-wider mb-2">
          {% if locale == "de" %}Nachricht{% else %}Message{% endif %} <span class="text-red-500">*</span>
        </label>
        <textarea
          id="inquiry-message"
          name="message"
          required
          rows="5"
          class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors resize-none"
          placeholder="{% if locale == 'de' %}Teile uns deine Anfrage mit...{% else %}Tell us about your inquiry...{% endif %}"
        ></textarea>
      </div>

      {# Details Expander Button #}
      <button
        type="button"
        id="inquiry-details-toggle"
        class="w-full flex items-center justify-between border border-zinc-700 px-4 py-3 text-white hover:bg-zinc-900 transition-colors"
      >
        <span class="font-semibold uppercase tracking-wider text-sm">
          {% if locale == "de" %}Anfragedetails hinzufügen{% else %}Add Inquiry Details{% endif %}
        </span>
        <svg class="w-5 h-5 transition-transform" id="inquiry-toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </button>

      {# Details Section (Collapsed by default) #}
      <div id="inquiry-details-content" class="hidden space-y-4 border border-zinc-700 p-4 bg-black">
        {# Basisfahrzeug #}
        <div>
          <div class="flex justify-between items-end mb-4">
            <h4 class="font-semibold uppercase tracking-wider text-sm">{% if locale == "de" %}Basisfahrzeug{% else %}Base Vehicle{% endif %}</h4>
            <div class="flex-1 ml-4 max-w-xs">
              <select name="base_vehicle_model" id="base_vehicle_model" class="w-full bg-black border border-zinc-700 px-4 py-3 text-white focus:border-white focus:outline-none transition-colors text-sm">
                <option value="">{% if locale == "de" %}Fahrzeug-Modell{% else %}Vehicle Model{% endif %}</option>
                <option value="Mercedes Benz Arocs">Mercedes Benz Arocs</option>
                <option value="MAN TGS">MAN TGS</option>
                <option value="anderes Fahrgestell">{% if locale == "de" %}anderes Fahrgestell{% else %}Other Chassis{% endif %}</option>
              </select>
            </div>
          </div>
          <div id="custom_vehicle_field" class="mb-4 hidden">
            <label class="block text-sm mb-1">{% if locale == "de" %}Bitte angeben{% else %}Please specify{% endif %}</label>
            <textarea name="base_vehicle_custom" id="base_vehicle_custom" placeholder="{% if locale == "de" %}Fahrzeugmodell{% else %}Vehicle model{% endif %}" class="w-full bg-black border border-zinc-700 px-4 py-3 text-white focus:border-white focus:outline-none transition-colors text-sm resize-none" rows="2"></textarea>
          </div>
          <div class="space-y-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_radstandsverlaengerung" value="Radstandsverlängerung" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Radstandsverlängerung{% else %}Wheelbase Extension{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_reifendruckregelung" value="Reifendruckregelanlage" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Reifendruckregelanlage{% else %}Tire Pressure Control{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_hebestu" value="Hydraulische Hebestützen" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Hydraulische Hebestützen{% else %}Hydraulic Support Legs{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_beleuchtung" value="Arbeitsbeleuchtung/Lightbars" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Arbeitsbeleuchtung/Lightbars{% else %}Work Lights/Lightbars{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_seilwinde" value="Seilwinde" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Seilwinde{% else %}Winch{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_tankanlage" value="Tankanlage" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Tankanlage{% else %}Fuel System{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_treppe" value="Treppe" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Treppe{% else %}Staircase{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_dachtraeger" value="Dachträger" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Dachträger{% else %}Roof Rack{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_staukaesten" value="Staukästen" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Staukästen{% else %}Storage Boxes{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_auszugsplattform" value="Auszugsplattform (Balkon)" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Auszugsplattform (Balkon){% else %}Slide-Out Platform (Balcony){% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_aussenküche" value="Außenküche" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Außenküche{% else %}Outdoor Kitchen{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_kamera" value="360° Kamerasystem" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}360° Kamerasystem{% else %}360° Camera System{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_lackierung" value="Lackierung" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Lackierung{% else %}Paintwork{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_basisfahrzeug_hecktraeger" value="Heckträger" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Heckträger{% else %}Rear Carrier{% endif %}</span>
            </label>
          </div>
        </div>

        {# Gewünschte Schnittstellen #}
        <div class="border-t border-zinc-700 pt-4">
          <h4 class="font-semibold uppercase tracking-wider text-sm mb-2">{% if locale == "de" %}Gewünschte Schnittstellen zwischen Fahrzeug und Wohnkabine{% else %}Desired Interfaces Between Vehicle and Cabin{% endif %}</h4>
          <div class="space-y-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_schnittstellen_zwischenrahmen" value="Zwischenrahmen" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Zwischenrahmen{% else %}Intermediate Frame{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_schnittstellen_durchstieg" value="Durchstieg" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Durchstieg{% else %}Pass-Through{% endif %}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="details_schnittstellen_durchstieg_fenster" value="Durchstieg mit Fenster" data-sevdesk-id="" class="inquiry-detail-checkbox">
              <span class="text-sm">{% if locale == "de" %}Durchstieg mit Fenster{% else %}Pass-Through with Window{% endif %}</span>
            </label>
          </div>
        </div>

        {# Leerkabine #}
        <div class="border-t border-zinc-700 pt-4">
          <h4 class="font-semibold uppercase tracking-wider text-sm mb-2">{% if locale == "de" %}Leerkabine{% else %}Bare Cabin{% endif %}</h4>
          
          {# Dimensions and Paintwork Fields #}
          <div class="space-y-3 mb-4 pb-4 border-b border-zinc-700">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label for="bare_cabin_length" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                  {% if locale == "de" %}Länge (außen){% else %}Length (outside){% endif %}
                </label>
                <input
                  type="text"
                  id="bare_cabin_length"
                  name="bare_cabin_length"
                  placeholder="m"
                  class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="bare_cabin_width" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                  {% if locale == "de" %}Breite (außen){% else %}Width (outside){% endif %}
                </label>
                <input
                  type="text"
                  id="bare_cabin_width"
                  name="bare_cabin_width"
                  placeholder="m"
                  class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="bare_cabin_height" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                  {% if locale == "de" %}Höhe (außen){% else %}Height (outside){% endif %}
                </label>
                <input
                  type="text"
                  id="bare_cabin_height"
                  name="bare_cabin_height"
                  placeholder="m"
                  class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
                />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="bare_cabin_paintwork" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                  {% if locale == "de" %}Lackierung{% else %}Paintwork{% endif %}
                </label>
                <select
                  id="bare_cabin_paintwork"
                  name="bare_cabin_paintwork"
                  class="w-full bg-black border border-zinc-700 px-4 py-3 text-white focus:border-white focus:outline-none transition-colors"
                >
                  <option value="">{% if locale == "de" %}Wähle ein Element aus{% else %}Select an element{% endif %}</option>
                  <option value="Uni-Lack">{% if locale == "de" %}Uni-Lack{% else %}Uni Paint{% endif %}</option>
                  <option value="Metallic- oder Matt-Lack">{% if locale == "de" %}Metallic- oder Matt-Lack{% else %}Metallic or Matte Paint{% endif %}</option>
                </select>
              </div>
              <div>
                <label for="bare_cabin_color_code" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                  {% if locale == "de" %}Farbbezeichnung/-code{% else %}Color Name/Code{% endif %}
                </label>
                <input
                  type="text"
                  id="bare_cabin_color_code"
                  name="bare_cabin_color_code"
                  class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors"
                  placeholder="{% if locale == 'de' %}z.B. DB 447{% else %}e.g. DB 447{% endif %}"
                />
              </div>
            </div>
          </div>

          <div class="space-y-3">
            {# Treppe #}
            <div>
              <label for="bare_cabin_treppe" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                {% if locale == "de" %}Treppe{% else %}Staircase{% endif %}
              </label>
              <select
                id="bare_cabin_treppe"
                name="bare_cabin_treppe"
                class="w-full bg-black border border-zinc-700 px-4 py-3 text-white focus:border-white focus:outline-none transition-colors"
              >
                <option value="">{% if locale == "de" %}Wähle ein Element aus{% else %}Select an element{% endif %}</option>
                <option value="Staukastentreppe Frontalaufstieg manuell">{% if locale == "de" %}Staukastentreppe Frontalaufstieg manuell{% else %}Storage Box Staircase - Front Ascent Manual{% endif %}</option>
                <option value="Staukastentreppe seitlicher Aufstieg manuell">{% if locale == "de" %}Staukastentreppe seitlicher Aufstieg manuell{% else %}Storage Box Staircase - Lateral Ascent Manual{% endif %}</option>
                <option value="Staukastentreppe seitlicher Aufstieg elektrisch">{% if locale == "de" %}Staukastentreppe seitlicher Aufstieg elektrisch{% else %}Storage Box Staircase - Lateral Ascent Electric{% endif %}</option>
                <option value="Auszugsleiter im Containerrahmen(nur Unimog)">{% if locale == "de" %}Auszugsleiter im Containerrahmen (nur Unimog){% else %}Retractable Ladder in Container Frame (Unimog only){% endif %}</option>
              </select>
            </div>

            {# Tür #}
            <div>
              <label for="bare_cabin_tuer" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                {% if locale == "de" %}Tür{% else %}Door{% endif %}
              </label>
              <select
                id="bare_cabin_tuer"
                name="bare_cabin_tuer"
                class="w-full bg-black border border-zinc-700 px-4 py-3 text-white focus:border-white focus:outline-none transition-colors"
              >
                <option value="">{% if locale == "de" %}Wähle ein Element aus{% else %}Select an element{% endif %}</option>
                <option value="3-Punkt verriegelte Tür ohne Fenster">{% if locale == "de" %}3-Punkt verriegelte Tür ohne Fenster{% else %}3-point locking door without window{% endif %}</option>
                <option value="3-Punkt verriegelte Tür mit Fenster">{% if locale == "de" %}3-Punkt verriegelte Tür mit Fenster{% else %}3-point locking door with window{% endif %}</option>
              </select>
            </div>

            {# Seitenfenster #}
            <fieldset class="border border-zinc-700 p-3">
              <legend class="text-sm font-semibold uppercase tracking-wider">{% if locale == "de" %}Seitenfenster{% else %}Side Windows{% endif %}</legend>
              <div class="space-y-2 mt-3">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label for="side_window_klein" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                      {% if locale == "de" %}Hartglas klein (Stk.){% else %}Hardglass Small (Qty){% endif %}
                    </label>
                    <input type="text" id="side_window_klein" name="side_window_klein" class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="side_window_gross" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                      {% if locale == "de" %}Hartglas groß (Stk.){% else %}Hardglass Large (Qty){% endif %}
                    </label>
                    <input type="text" id="side_window_gross" name="side_window_gross" class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="side_window_panorama" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                      {% if locale == "de" %}Hartglas Panorama (Stk.){% else %}Hardglass Panorama (Qty){% endif %}
                    </label>
                    <input type="text" id="side_window_panorama" name="side_window_panorama" class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors" />
                  </div>
                </div>
              </div>
            </fieldset>

            {# Dachfenster #}
            <fieldset class="border border-zinc-700 p-3">
              <legend class="text-sm font-semibold uppercase tracking-wider">{% if locale == "de" %}Dachfenster{% else %}Roof Windows{% endif %}</legend>
              <div class="space-y-2 mt-3">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="roof_window_klein" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                      {% if locale == "de" %}Hartglas klein (Stk.){% else %}Hardglass Small (Qty){% endif %}
                    </label>
                    <input type="text" id="roof_window_klein" name="roof_window_klein" class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="roof_window_gross" class="block text-sm font-semibold uppercase tracking-wider mb-2">
                      {% if locale == "de" %}Hartglas groß (Stk.){% else %}Hardglass Large (Qty){% endif %}
                    </label>
                    <input type="text" id="roof_window_gross" name="roof_window_gross" class="w-full bg-black border border-zinc-700 px-4 py-3 text-white placeholder-zinc-600 focus:border-white focus:outline-none transition-colors" />
                  </div>
                </div>
              </div>
            </fieldset>

            {# Stauklappen #}
            <div class="border border-zinc-700 p-3">
              <h5 class="text-sm font-semibold uppercase tracking-wider mb-2">{% if locale == "de" %}Stauklappen{% else %}Storage Doors{% endif %}</h5>
              <div class="space-y-2">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="details_stauklappen_seitlich" value="Stauklappen seitlich" data-sevdesk-id="" class="inquiry-detail-checkbox">
                  <span class="text-sm">{% if locale == "de" %}Seitlich{% else %}Lateral{% endif %}</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="details_stauklappen_hinten" value="Stauklappen nach hinten" data-sevdesk-id="" class="inquiry-detail-checkbox">
                  <span class="text-sm">{% if locale == "de" %}Nach hinten{% else %}Rear{% endif %}</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="details_stauklappen_boxen" value="Boxen-Auszugsystem in Heckgarage" data-sevdesk-id="" class="inquiry-detail-checkbox">

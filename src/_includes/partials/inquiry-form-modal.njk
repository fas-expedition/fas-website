      </div>

      {# Hidden locale field for Netlify Form #}
      <input type="hidden" name="locale" id="inquiry-locale" value="{{ locale }}" />
      <input type="hidden" name="selected_details" id="inquiry-selected-details" value="" />

      {# Document Upload #}
      <div class="pt-4">
        <label for="inquiry-documents" class="block text-sm font-semibold uppercase tracking-wider mb-2">
          {% if locale == "de" %}Dokumente hochladen{% else %}Upload Documents{% endif %}
        </label>
        <input 
          type="file" 
          id="inquiry-documents" 
          name="documents" 
          multiple 
          class="hidden"
          accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.xls,.xlsx"
        />
        <div 
          id="inquiry-documents-display" 
          class="w-full bg-black border border-zinc-700 px-4 py-3 text-zinc-400 hover:border-white cursor-pointer transition-colors"
        >
          {% if locale == "de" %}Klicken zum Hochladen{% else %}Click to Upload{% endif %}
        </div>
      </div>

      {# Submit Button #}
      <div class="flex gap-4 pt-4">
        <button
          type="submit"
          class="flex-1 bg-white text-black px-8 py-3 font-bold tracking-widest uppercase hover:bg-zinc-200 transition-colors"
        >
          {% if locale == "de" %}Anfrage senden{% else %}Send Inquiry{% endif %}
        </button>
        <button
          type="button"
          class="inquiry-form-close flex-1 border border-zinc-700 text-white px-8 py-3 font-bold tracking-widest uppercase hover:bg-zinc-900 transition-colors"
        >
          {% if locale == "de" %}Abbrechen{% else %}Cancel{% endif %}
        </button>
      </div>

      <p class="text-xs text-zinc-500 text-center">
        <span class="text-red-500">*</span> {% if locale == "de" %}Erforderliche Felder{% else %}Required fields{% endif %}
      </p>
    </form>
  </div>
</div>

{# Hidden Netlify Form for backend processing (blueprint for form detection) #}
<form name="inquiry" method="POST" netlify netlify-honeypot="bot-field" hidden>
  {# Honeypot field hidden with CSS positioning (not display:none per Netlify requirement) #}
  <p style="position: absolute; overflow: hidden; clip: rect(0 0 0 0); height: 1px; width: 1px; margin: -1px; padding: 0; border: 0;">
    <input type="hidden" name="bot-field" />
  </p>
  <input type="text" name="name" />
  <input type="text" name="street" />
  <input type="text" name="postal" />
  <input type="text" name="country" />
  <input type="email" name="email" />
  <input type="tel" name="phone" />
  <textarea name="message"></textarea>
  <input type="text" name="locale" />
  <input type="text" name="selectedDetails" />
  <textarea name="specialWishes"></textarea>
  <input type="text" name="base_vehicle_model" />
  <input type="text" name="base_vehicle_custom" />
</form>

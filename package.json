{
  "name": "fas-expedition-site",
  "version": "1.0.0",
  "description": "FAS Expedition - Static website built with Eleventy",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npx @11ty/eleventy --serve --watch\" \"npx tailwindcss -i src/assets/css/main.css -o src/assets/css/output.css --watch\"",
    "build:css": "npx tailwindcss -i src/assets/css/main.css -o src/assets/css/output.css --minify",
    "build:11ty": "npx @11ty/eleventy",
    "build": "npm run build:css && npm run build:11ty",
    "clean": "rm -rf _site || true",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-yaml": "^4.0.9",
    "autoprefixer": "^10.4.0",
    "cheerio": "^1.0.0",
    "concurrently": "^8.0.0",
    "fast-check": "^3.0.0",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.1"
  }
}
